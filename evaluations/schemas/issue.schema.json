{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "models", "title", "created_at", "state", "generalization", "source", "goal", "observations", "knowledge_refs", "related_rules"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "title": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "state": {"enum": ["open", "resolved", "withdrawn"]},
    "generalization": {"const": "pending_validation"},
    "maintenance_workflow": {"const": "three_stage_v1"},
    "completion": {
      "type": "object", "additionalProperties": false,
      "required": ["task_type", "backend", "optimization_goal"],
      "properties": {
        "task_type": {"enum": ["model_migration", "module_validation", "optimization_investigation", "tooling"]},
        "backend": {"enum": ["cpu", "cuda", "npu"]},
        "optimization_goal": {"enum": ["required_gain", "investigate", "not_applicable"]}
      },
      "allOf": [
        {"if": {"properties": {"task_type": {"const": "model_migration"}}},
         "then": {"properties": {"backend": {"const": "npu"}}}},
        {"if": {"properties": {"task_type": {"const": "optimization_investigation"}}},
         "then": {"properties": {"optimization_goal": {"enum": ["required_gain", "investigate"]}}}}
      ]
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "baseline_revision"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "baseline_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "intake": {
          "type": "object", "additionalProperties": false,
          "required": ["dirty", "fingerprint_status", "fingerprint_gaps", "submodules"],
          "properties": {
            "dirty": {"type": "boolean"},
            "fingerprint_status": {"const": "not_collected"},
            "fingerprint_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "submodules": {"type": "array", "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "index_revision", "checkout_revision", "status", "dirty"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "index_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "checkout_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
                "status": {"enum": ["initialized", "uninitialized", "revision_mismatch", "unavailable"]},
                "dirty": {"type": ["boolean", "null"]}
              }
            }}
          }
        }
      }
    },
    "goal": {"type": "string", "minLength": 1},
    "observations": {"type": "string"},
    "knowledge_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "related_rules": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
