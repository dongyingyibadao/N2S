{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "case_id", "title", "state", "claim", "level", "requirements", "depends_on", "evidence_refs", "protocol", "execution"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "title": {"type": "string", "minLength": 1},
    "state": {"enum": ["draft", "ready", "withdrawn"]},
    "claim": {"type": "string", "minLength": 1},
    "level": {"enum": ["observation", "module", "integration", "model"]},
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["backends", "device_name_contains", "versions"],
      "properties": {
        "backends": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["cpu", "cuda", "npu"]}},
        "device_name_contains": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "versions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["input_description", "seed", "assets", "variant", "acceptance", "comparison_key"],
      "properties": {
        "input_description": {"type": "string", "minLength": 1},
        "seed": {"type": ["integer", "null"]},
        "assets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "sha256"], "properties": {"name": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
        "variant": {"enum": ["baseline", "modified", "control"]},
        "acceptance": {"type": "string", "minLength": 1},
        "comparison_key": {"type": "string", "minLength": 1}
      }
    },
    "execution": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
          "required": ["argv", "timeout_seconds", "estimated_minutes", "memory_gb", "network", "installs_dependencies"],
          "properties": {
            "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
            "estimated_minutes": {"type": "number", "minimum": 0},
            "memory_gb": {"type": "number", "minimum": 0},
            "network": {"type": "boolean"},
            "installs_dependencies": {"type": "boolean"}
          }
        }
      ]
    }
  },
  "allOf": [{"if": {"properties": {"state": {"const": "ready"}}}, "then": {"properties": {"execution": {"type": "object"}}}}]
}
