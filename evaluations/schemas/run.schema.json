{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "models", "task", "task_sha256", "task_snapshot", "started_at", "finished_at", "status", "exit_code", "environment", "source", "n2s_revision", "rules_before", "rules_after", "plan_sha256", "raw_log_sha256", "summary", "evidence", "generalization"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "task": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"},
    "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_snapshot": {"type": "object"},
    "started_at": {"type": "string"}, "finished_at": {"type": "string"},
    "status": {"enum": ["command_succeeded", "command_failed", "timed_out", "interrupted", "safety_violation", "reported_pass", "reported_failure", "blocked"]},
    "exit_code": {"type": ["integer", "null"]},
    "environment": {"type": "object"}, "source": {"type": "object"},
    "n2s_revision": {"type": "string"},
    "rules_before": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rules_after": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": ["string", "null"]},
    "raw_log_sha256": {"type": ["string", "null"]},
    "parent_run_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {"type": "string", "minLength": 1},
    "generalization": {"const": "pending_validation"},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  }
}
