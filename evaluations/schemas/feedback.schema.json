{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "case_id", "recorded_at", "generalization", "stage", "kind", "summary", "queries", "source_checks", "evidence_refs", "evidence_sha256", "resolves"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "recorded_at": {"type": "string", "minLength": 1},
    "generalization": {"const": "pending_validation"},
    "stage": {"enum": ["preparation", "troubleshooting", "optimization"]},
    "kind": {"enum": ["lookup", "failure", "numerical_issue", "change", "resolution", "validation"]},
    "summary": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "project_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "project_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rollback": {"type": "string", "minLength": 1},
    "queries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resolves": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "error": {
      "type": "object", "additionalProperties": false, "required": ["type", "message", "expected", "observed"],
      "properties": {
        "type": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1}, "observed": {"type": "string", "minLength": 1},
        "stack_excerpt": {"type": "string"}
      }
    },
    "source_checks": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "url", "accessed_at", "status", "trust", "claim", "applicability", "comparison"],
      "properties": {
        "uri": {"type": ["string", "null"], "pattern": "^(upstream://[a-z0-9-]+@[0-9a-f]{40}/.+|community://[a-z0-9-]+@[0-9a-f]{40}/.+|reference://[a-z0-9-]+@[0-9a-f]{64}/.+|cases/[^\\s]+)$"},
        "url": {"type": ["string", "null"], "pattern": "^https://"},
        "accessed_at": {"type": "string", "minLength": 1},
        "status": {"enum": ["read", "partial", "unavailable", "no_match"]},
        "trust": {"enum": ["accepted_upstream_documented", "unreviewed_latest_upstream", "community_source_snapshot_static_only", "community_reference_bundle", "retrieved_unreviewed", "n2s_case_evidence", "unavailable"]},
        "claim": {"type": "string", "minLength": 1},
        "applicability": {"enum": ["applicable", "related", "different_scope", "contrary", "unknown", "no_match"]},
        "comparison": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }},
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["functional", "official_weights", "actual_backend", "finite_outputs", "accuracy", "accuracy_protocol", "optimization", "performance"],
      "properties": {
        "functional": {"enum": ["passed", "failed", "pending"]},
        "official_weights": {"type": "boolean"},
        "actual_backend": {"enum": ["cpu", "cuda", "npu"]},
        "finite_outputs": {"type": "boolean"},
        "accuracy": {"enum": ["passed", "failed", "pending"]},
        "accuracy_protocol": {"type": "string", "minLength": 1},
        "optimization": {"enum": ["measured_improvement", "no_gain", "regression", "blocked", "pending", "not_applicable"]},
        "performance": {
          "type": "object", "additionalProperties": false,
          "required": ["metric", "direction", "baseline", "modified", "same_device", "protocol"],
          "properties": {
            "metric": {"type": "string", "minLength": 1}, "direction": {"enum": ["lower", "higher"]},
            "baseline": {"type": ["number", "null"], "minimum": 0}, "modified": {"type": ["number", "null"], "minimum": 0},
            "same_device": {"type": "boolean"}, "protocol": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "lookup"}}}, "then": {"properties": {"queries": {"minItems": 1}, "source_checks": {"minItems": 1}}}},
    {"if": {"properties": {"kind": {"enum": ["failure", "numerical_issue"]}}}, "then": {"required": ["error", "environment"]}},
    {"if": {"properties": {"kind": {"const": "change"}}}, "then": {"required": ["rollback"]}},
    {"if": {"properties": {"kind": {"const": "resolution"}}}, "then": {"properties": {"resolves": {"minItems": 1}, "evidence_refs": {"minItems": 1}}}},
    {"if": {"properties": {"kind": {"const": "validation"}}}, "then": {"required": ["validation", "environment"], "properties": {"evidence_refs": {"minItems": 1}}}}
  ]
}
