+
+mkdir -p "$(dirname -- "$OUTPUT_DIR")"
+if [[ -n "$DEVICE_IDS" ]]; then
+    export ASCEND_RT_VISIBLE_DEVICES="$DEVICE_IDS"
+else
+    unset ASCEND_RT_VISIBLE_DEVICES || true
+fi
+export HCCL_CONNECT_TIMEOUT="${HCCL_CONNECT_TIMEOUT:-1800}"
+
+retain_log() {
