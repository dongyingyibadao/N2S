+    "--job_name=$RUN_NAME"
+    "--steps=$STEPS"
+    "--batch_size=$MICRO_BATCH"
+    "--num_workers=4"
+    "--eval_freq=0"
+    "--log_freq=1"
+    "--save_checkpoint=$SAVE_CHECKPOINT"
+    "--save_freq=$SAVE_FREQ"
