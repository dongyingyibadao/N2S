{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "N2S MINT CUDA capture manifest",
  "type": "object",
  "required": [
    "schema_version", "status", "backend", "scope", "model_execution",
    "model_parameters_loaded", "harness_exit_code",
    "environment", "results", "logs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "captured"},
    "backend": {"const": "cuda"},
    "scope": {"const": "operator_block_ab"},
    "model_execution": {"const": false},
    "model_parameters_loaded": {"const": false},
    "harness_exit_code": {"type": "integer", "minimum": 0},
    "environment": {
      "type": "object",
      "required": ["device", "torch", "cuda_runtime"],
      "additionalProperties": true
    },
    "results": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes", "test_ids", "test_statuses"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "test_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "test_statuses": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["passed", "failed", "skipped"]}
          }
        }
      }
    },
    "logs": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
