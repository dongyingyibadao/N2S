{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blob_sha256": {"pattern": "^[0-9a-f]{64}$", "type": ["string", "null"]},
          "devices": {"items": {"type": "string"}, "type": "array"},
          "entry_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
          "git_object_id": {"pattern": "^[0-9a-f]{40,64}$", "type": "string"},
          "git_object_type": {"enum": ["blob", "commit"], "type": "string"},
          "mode": {"pattern": "^[0-9]{6}$", "type": "string"},
          "model": {"type": ["string", "null"]},
          "modes": {"items": {"type": "string"}, "type": "array"},
          "ownership": {"enum": ["upstream_repository", "third_party_or_separately_licensed"], "type": "string"},
          "path": {"minLength": 1, "type": "string"},
          "revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
          "sha256_basis": {"enum": ["blob_content", "gitlink_commit_id"], "type": "string"},
          "software_versions": {
            "additionalProperties": false,
            "properties": {
              "cann": {"items": {"type": "string"}, "type": "array"},
              "framework": {"items": {"type": "string"}, "type": "array"},
              "pytorch": {"items": {"type": "string"}, "type": "array"},
              "torch_npu": {"items": {"type": "string"}, "type": "array"}
            },
            "required": ["cann", "framework", "pytorch", "torch_npu"],
            "type": "object"
          },
          "source": {"type": "string"},
          "title": {"type": ["string", "null"]},
          "type": {"enum": ["binary", "code", "configuration", "document", "license", "patch", "submodule", "text"], "type": "string"},
          "url": {"type": "string"}
        },
        "required": ["blob_sha256", "devices", "entry_sha256", "git_object_id", "git_object_type", "mode", "model", "modes", "ownership", "path", "revision", "sha256_basis", "software_versions", "source", "title", "type", "url"],
        "type": "object"
      },
      "type": "array"
    },
    "revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "schema_version": {"const": "1.0.0"},
    "source": {"type": "string"},
    "trust": {"const": "upstream_documented"}
  },
  "required": ["files", "revision", "schema_version", "source", "trust"],
  "type": "object"
}
