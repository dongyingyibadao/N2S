{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "items": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "title", "summary", "tasks", "stages", "scopes", "keywords", "evidence", "conditions", "limitations", "references", "links"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"},
        "source": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "tasks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["environment", "training", "inference", "distributed", "memory", "numerics", "performance", "simulation", "data"]}},
        "stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["preparation", "troubleshooting", "optimization"]}},
        "scopes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "keywords": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence": {"enum": ["documented", "reported_smoke", "reported_short_run", "unresolved", "template_only", "historical_resource"]},
        "conditions": {"type": "string", "minLength": 1},
        "limitations": {"type": "string", "minLength": 1},
        "references": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["path"],
          "properties": {"path": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}}
        }},
        "links": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["url", "label", "authority", "content_status", "revision"],
          "properties": {
            "url": {"type": "string", "pattern": "^https://"},
            "label": {"type": "string", "minLength": 1},
            "authority": {"enum": ["official", "community", "internal_support", "platform"]},
            "content_status": {"enum": ["bundle_reports_read", "partial", "not_read", "requires_login", "historical_resource"]},
            "revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
            "snapshot_uri": {"type": "string", "pattern": "^upstream://[a-z0-9-]+@[0-9a-f]{40}/.+"}
          }
        }}
      }
    }}
  }
}
